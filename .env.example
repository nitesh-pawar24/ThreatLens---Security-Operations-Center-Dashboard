# ThreatLens – Environment Configuration Template
# ==================================================
# Copy this file to .env.local (frontend) or .env (backend) and fill in values.
# NOTE: .env, .env.local, and .env.production are listed in .gitignore and must never be committed.

# ── Frontend (Vercel / Vite) ───────────────────────────────────────────────────
# Base URL of the deployed backend API.
# In local development: leave empty to route through the Vite proxy to http://127.0.0.1:8000.
# In production on Vercel: set to your deployed Render service URL (e.g., https://threatlens-backend.onrender.com)
VITE_API_BASE_URL=

# ── Backend (Render / FastAPI) ─────────────────────────────────────────────────
# Port for the Uvicorn ASGI server (Render automatically sets $PORT)
PORT=8000

# Allowed frontend origins for CORS.
# In local development: localhost:5173 and localhost:3000 are allowed by default.
# In production on Render: set to your deployed Vercel URL (e.g., https://threatlens.vercel.app)
# Supports comma-separated origins if multiple environments are used.
FRONTEND_ORIGIN=https://your-threatlens-app.vercel.app

# Maximum file upload size in megabytes (default: 10; the Render blueprint uses 5)
MAX_UPLOAD_SIZE_MB=10

# Maximum rows per uploaded CSV (default: 50000; the Render blueprint uses 10000).
# Enforced after parsing and BEFORE the expensive detection step.
MAX_UPLOAD_ROWS=50000

# In-memory sliding-window rate limiting (true / false, default: true)
RATE_LIMIT_ENABLED=true

# ── Public uploads: per-visitor sessions ───────────────────────────────────────
# true  = every visitor gets a private, expiring, in-memory session (X-Session-ID header).
#         There is no shared dataset. Recommended for both local testing and public deployments.
# false = one process-wide dataset (legacy single-tenant mode).
MULTI_TENANT_SESSIONS=true

# Emergency kill switch. true blocks ALL writes (uploads, resets, sample loading, threshold
# changes) in both modes unless ADMIN_API_KEY is presented. Reads keep working.
# Safety net: on Render, PORTFOLIO_READ_ONLY=false without MULTI_TENANT_SESSIONS=true is
# forced back to read-only (set ALLOW_SHARED_GLOBAL_STATE=true only if you really mean it).
PORTFOLIO_READ_ONLY=false

# Session limits (defaults shown). Run a SINGLE uvicorn worker: sessions live in process memory.
SESSION_TTL_MINUTES=30            # idle expiry for sessions that hold data
SESSION_EMPTY_TTL_MINUTES=5       # idle expiry for sessions that never uploaded anything
MAX_ACTIVE_SESSIONS=500
MAX_SESSION_MEMORY_MB=35          # per-session dataset budget (estimated, not RSS)
MAX_TOTAL_MEMORY_MB=220           # all sessions combined (estimated, not RSS)
MAX_CONCURRENT_ANALYSES=2         # simultaneous parse+detect jobs; extra uploads get HTTP 503
SESSION_CREATE_LIMIT_PER_MIN=10   # per client IP
UPLOAD_RATE_LIMIT_PER_MIN=20      # per client IP
RATE_LIMIT_PER_MIN=120            # per client IP, all other requests

# Which header carries the real client IP for rate limiting. Empty = use the socket address
# (X-Forwarded-For is never trusted). On Render this defaults to true-client-ip (set by Cloudflare).
CLIENT_IP_HEADER=

# Optional administrative API key (server-side only; NEVER put it in a VITE_* variable).
# Lets an operator write while PORTFOLIO_READ_ONLY=true, and protects PUT /api/detection/config
# when MULTI_TENANT_SESSIONS=false.
ADMIN_API_KEY=
