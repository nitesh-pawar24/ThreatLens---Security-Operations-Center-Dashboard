# ThreatLens – Environment Configuration Template
# ==================================================
# Copy this file to .env.local (frontend) or .env (backend) and fill in values.
# NOTE: .env, .env.local, and .env.production are listed in .gitignore and must never be committed.

# ── Frontend (Vercel / Vite) ───────────────────────────────────────────────────
# Base URL of the deployed backend API.
# In local development: leave empty to route through the Vite proxy to http://127.0.0.1:8000.
# In production on Vercel: set to your deployed Render service URL (e.g., https://threatlens-backend.onrender.com)
VITE_API_BASE_URL=

# ── Backend (Render / FastAPI) ─────────────────────────────────────────────────
# Port for the Uvicorn ASGI server (Render automatically sets $PORT)
PORT=8000

# Allowed frontend origins for CORS.
# In local development: localhost:5173 and localhost:3000 are allowed by default.
# In production on Render: set to your deployed Vercel URL (e.g., https://threatlens.vercel.app)
# Supports comma-separated origins if multiple environments are used.
FRONTEND_ORIGIN=https://your-threatlens-app.vercel.app

# Maximum file upload size in megabytes (default: 10)
MAX_UPLOAD_SIZE_MB=10

# Maximum rows allowed per uploaded CSV dataset to prevent memory exhaustion (default: 50000)
MAX_UPLOAD_ROWS=50000

# In-memory sliding-window rate limiting (true / false, default: true)
RATE_LIMIT_ENABLED=true

# Set to true for public portfolio deployments (Render) to prevent unauthenticated visitors
# from mutating shared in-memory backend state. Set to false for full local analysis access.
PORTFOLIO_READ_ONLY=false

# Optional administrative API key to authorize write operations when PORTFOLIO_READ_ONLY is true
# and protect PUT /api/detection/config.
ADMIN_API_KEY=
