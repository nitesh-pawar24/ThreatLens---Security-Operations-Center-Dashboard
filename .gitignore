# ── Node / Frontend ────────────────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local
.vite/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Python / Backend ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# Virtual environments
venv/
env/
.venv/
.env/
ENV/

# Pytest / coverage / build
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/
.cache/

# ── Environment variables ──────────────────────────────────────────────────────
